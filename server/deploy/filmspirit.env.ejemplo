# ============================================================
# FilmSpirit · configuración del servidor
# Este archivo vive en la VPS en /etc/filmspirit/filmspirit.env
# Edítalo con:  sudo nano /etc/filmspirit/filmspirit.env
# y aplica los cambios con:  sudo systemctl restart filmspirit
# NUNCA pegues estas claves en un chat ni las subas a ningún lado.
# ============================================================

# Dirección pública (con https, sin / al final)
BASE_URL=https://__DOMINIO__

# Entrar con Google: «ID de cliente» de la consola de Google Cloud (termina en .apps.googleusercontent.com)
GOOGLE_CLIENT_ID=

# Cuentas que ven el panel de administración (/admin), separadas por comas.
# Activa la verificación en dos pasos de Google en cada una: el panel se abre con esas cuentas.
ADMIN_EMAILS=
# El panel pide haber entrado con Google hace menos de estas horas (si no, pide entrar de nuevo)
# ADMIN_SESSION_HOURS=12

# ---------- Planes ----------
# Guion (gratis): 5 guiones activos, hasta 4 personas escribiendo, solo texto.
# Indie: 2 proyectos de producción activos, solo tú, 5 GB. Pro: 7, 30 personas, 20 GB. Studio: 20, 60 personas, 100 GB.
# Indie, Pro y Studio: guiones sin límite. (Solo cámbialos si quieres otros límites.)
# FREE_SCRIPTS=5
# INDIE_PROJECTS=2
# INDIE_MEMBERS=1
# PRO_PROJECTS=7
# PRO_MEMBERS=30
# STUDIO_PROJECTS=20
# STUDIO_MEMBERS=60
# Proyectos archivados que cada plan puede guardar además de los activos (Guion 10, Indie 20, Pro 60, Studio 200)
# FREE_ARCHIVED=10
# INDIE_ARCHIVED=20
# PRO_ARCHIVED=60
# STUDIO_ARCHIVED=200
# Espacio por cuenta en MB (Guion 100, Indie 5000, Pro 20000, Studio 100000)
# FREE_STORAGE_MB=100
# INDIE_STORAGE_MB=5000
# PRO_STORAGE_MB=20000
# STUDIO_STORAGE_MB=100000
# Copias del libro de reclamaciones por correo: tope diario en total (además, 2 al día por destinatario)
# RECLAMOS_CORREOS_DIA=100
# Copias a SUPPORT_EMAIL por día (las hojas se guardan siempre y se ven en el panel)
# RECLAMOS_SOPORTE_DIA=200

# ---------- Precios ----------
# En el Perú, en soles con IGV (Mercado Pago). El anual cuesta 10 meses.
PEN_INDIE_MONTH=29
PEN_INDIE_YEAR=290
PEN_PRO_MONTH=49
PEN_PRO_YEAR=490
PEN_STUDIO_MONTH=129
PEN_STUDIO_YEAR=1290
# Fuera del Perú, en dólares (Paddle). El cobro real lo fija cada precio en Paddle: deja estos números iguales a los de allá.
USD_INDIE_MONTH=7.99
USD_INDIE_YEAR=79
USD_PRO_MONTH=14.99
USD_PRO_YEAR=149
USD_STUDIO_MONTH=39
USD_STUDIO_YEAR=390
# Precio de fundador de Pro: quien se suscribe antes de esta fecha paga S/ 39 al mes (390 al año) mientras siga suscrito.
# Fuera del Perú, el código FUNDADOR (20 % recurrente) de Paddle (PADDLE_DISCOUNT_FUNDADOR).
FOUNDER_UNTIL=2027-02-28T23:59:59-05:00
# FOUNDER_PEN_MONTH=39
# FOUNDER_PEN_YEAR=390
# FOUNDER_USD_PCT=20

# ---------- Cobros en el Perú: Mercado Pago ----------
# (Tus integraciones › tu aplicación › Credenciales de producción › Access Token)
# Mientras esté vacío, la app muestra «Los pagos con Mercado Pago se habilitan muy pronto».
MP_ACCESS_TOKEN=
# Clave secreta de los avisos (Webhooks › Configurar notificaciones › Clave secreta). OBLIGATORIA: sin ella el
# servidor rechaza todos los avisos (las suscripciones se ponen al día igual, pero hasta una hora después)
MP_WEBHOOK_SECRET=

# ---------- Cobros fuera del Perú: Paddle ----------
# Paddle cobra en dólares, calcula y cobra los impuestos de cada país y emite los comprobantes.
# Developer tools › Authentication: una «API key» con permisos de escritura
PADDLE_API_KEY=
# Developer tools › Authentication › Client-side tokens: un token (empieza con live_ o test_)
PADDLE_CLIENT_TOKEN=
# Developer tools › Notifications › destino https://__DOMINIO__/api/billing/paddle-webhook
# (eventos subscription.* , transaction.* y adjustment.*): su «Secret key»
PADDLE_WEBHOOK_SECRET=
# sandbox mientras pruebas con la cuenta de prueba de Paddle; production al lanzar
PADDLE_ENV=production
# Catalog › Products: un producto por plan y dos precios por producto (mensual y anual): sus id (pri_…)
PADDLE_PRICE_INDIE_MONTH=
PADDLE_PRICE_INDIE_YEAR=
PADDLE_PRICE_PRO_MONTH=
PADDLE_PRICE_PRO_YEAR=
PADDLE_PRICE_STUDIO_MONTH=
PADDLE_PRICE_STUDIO_YEAR=
# Ningún plan tiene prueba gratis. Solo si ya tenías precios de Pro con «trial period» y alguien empezó su prueba con
# ellos: déjalos aquí hasta que esas pruebas terminen (se reconocen, no se ofrecen)
# PADDLE_PRICE_PRO_MONTH_TRIAL=
# PADDLE_PRICE_PRO_YEAR_TRIAL=
# Catalog › Discounts: el código FUNDADOR (20 %, recurrente, hasta el 28 de febrero de 2027): su id (dsc_…)
PADDLE_DISCOUNT_FUNDADOR=
# Checkout › Checkout settings › «Default payment link»: https://__DOMINIO__/pagar

# ---------- Cobros fuera del Perú sin Paddle: Lemon Squeezy (solo si Paddle está vacío) ----------
LS_API_KEY=
LS_STORE_ID=
LS_WEBHOOK_SECRET=
LS_VARIANT_INDIE_MONTH=
LS_VARIANT_INDIE_YEAR=
LS_VARIANT_PRO_MONTH=
LS_VARIANT_PRO_YEAR=
LS_VARIANT_STUDIO_MONTH=
LS_VARIANT_STUDIO_YEAR=
LS_TEST_MODE=0

# ---------- País de quien visita ----------
# Solo si un proxy delante del dominio pone el país en una cabecera: su nombre (con Cloudflare, CF-IPCountry).
# Vacío: el país sale de la zona horaria y del idioma del navegador (una cabecera de país que llegue sin proxy la
# puede inventar cualquiera, así que no se lee).
GEO_HEADER=

# Datos de la empresa para términos, privacidad y libro de reclamaciones
BUSINESS_NAME=
BUSINESS_RUC=
BUSINESS_ADDRESS=
LEGAL_DATE=
SUPPORT_EMAIL=

# Imágenes con IA (Studio): secreto que cifra las keys de Google de cada persona. Vacío: el servidor crea
# DATA_DIR/ia-secreto.key la primera vez (respáldalo junto con la base de datos)
IA_KEY_SECRET=

# Correos automáticos (opcional): resend o brevo, con su clave y un remitente de un dominio verificado
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_FROM=

# No cambiar
PORT=8080
HOST=127.0.0.1
DATA_DIR=/var/lib/filmspirit
TRUST_PROXY=1
NODE_ENV=production
